# Caddy issues and renews the TLS certificates by itself (Let's Encrypt),
# as long as both DNS records point at this server BEFORE the stack starts.

spikytail.com {
	encode zstd gzip
	root * /srv/web/current

	# Hashed Vite assets never change content under the same name.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	# EVERYTHING that is not a hashed asset is the SPA shell: every path
	# (/, /login, a deep link) falls back to index.html below, so it must
	# always be revalidated. The old `/index.html` matcher caught only that
	# literal path — a typed spikytail.com got NO Cache-Control at all, so
	# Safari cached the shell heuristically and kept booting the OLD bundle
	# on typed-URL visits, while a reload (which revalidates) showed the new
	# one. no-cache still allows 304s, so this costs one conditional request.
	@shell not path /assets/*
	header @shell Cache-Control "no-cache"

	# SPA fallback: /login, /privacy, ... are client-side routes.
	try_files {path} /index.html
	file_server
}

www.spikytail.com {
	redir https://spikytail.com{uri} permanent
}

api.spikytail.com {
	encode zstd gzip
	# WebSocket (/ws) is proxied by the same directive - no extra config needed.
	# Caddy sets X-Forwarded-For/Proto, which the app reads
	# (server.forward-headers-strategy=native + rate-limit trust flag).
	reverse_proxy app:8080
}

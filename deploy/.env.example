# Production environment - template.
# Copy to /opt/marel/.env on the server, fill in, then: chmod 600 .env
# NEVER commit the filled-in file anywhere.

# Which backend image tag is running. deploy.sh rewrites this line on every
# deploy; to ROLL BACK, set it to an older git sha and `docker compose up -d app`.
APP_IMAGE_TAG=latest

# --- database -----------------------------------------------------------
# Generate: openssl rand -base64 24
DB_PASSWORD=

# --- security -----------------------------------------------------------
# Generate: openssl rand -base64 64 | tr -d '\n'
# Must be NEW for production - never reuse the dev value.
JWT_SECRET=
# First sign-in password for the bootstrap admin account.
BOOTSTRAP_ADMIN_PASSWORD=
# Optional: the internal engineering account (the only role that can read
# /actuator/info and /actuator/metrics). Leave empty to not create it.
BOOTSTRAP_DEVELOPER_PASSWORD=

# --- URLs ---------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://spikytail.com
WEB_APP_URL=https://spikytail.com

# --- Google OAuth -------------------------------------------------------
# The redirect URI below must be registered VERBATIM in Google Cloud Console
# for this OAuth client, or "Continue with Google" fails.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.spikytail.com/api/auth/google/callback

# --- mail (Postmark) ----------------------------------------------------
# Both are the Postmark SERVER API token (not the account token).
# Leave empty until the spikytail.com domain is verified in Postmark;
# the app then logs mails instead of sending them.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@spikytail.com
MAIL_FROM_NAME=SpikyTail

# --- file storage -------------------------------------------------------
# local = ./uploads bind mount (included in backup.sh). r2 = Cloudflare R2.
APP_STORAGE_TYPE=local
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- AI assistant (optional; empty = feature off) ------------------------
OPENAI_API_KEY=

# --- backups (optional offsite copy) -------------------------------------
# An rclone remote like  r2backups:marel-db-backups  - see deploy/README.md.
# Empty = backups stay on this disk only (NOT recommended once live).
RCLONE_REMOTE=

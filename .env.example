# Local dev secrets. Copy to .env (git-ignored) and fill in real values.
# See scripts/run-dev.sh for how these get loaded, or export them yourself
# before running the app / setting up your IDE's run configuration.

# The role application.properties connects as (spring.datasource.username).
# On a fresh Homebrew Postgres with the default `trust` auth for local
# connections, Postgres never actually checks this value — but set a real
# one anyway, in case that ever changes.
DB_PASSWORD=

# Only used once: AdminInitializer checks whether the `admin` username
# already exists and does nothing if so. Changing this after that user has
# been created has no effect on the stored password — update the row's
# password_hash directly instead (BCryptPasswordEncoder, cost 10).
BOOTSTRAP_ADMIN_PASSWORD=

# HMAC signing key for access tokens (JwtService). Anyone with this value
# can mint a valid token for any user. Generate with, e.g.:
#   openssl rand -base64 48
JWT_SECRET=

# From Google Cloud Console, OAuth 2.0 Client for "Continue with Google".
# Safe to leave BOTH blank (empty, not unset) — GoogleOAuthService defaults
# to "" and Google sign-in is simply unavailable. The app must not be left
# with these keys UNSET, only empty: application.properties references them
# via ${GOOGLE_OAUTH_CLIENT_ID}, and an unset env var fails the whole boot
# with a PlaceholderResolutionException — a blank one resolves fine.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Postmark (e-mail) ---
# Both or neither. PostmarkEmailSender registers itself on MAIL_USERNAME alone, so
# a username with no key would register the adapter and then fail authentication
# on every send — five retries per message, all of them lost. Left blank, the app
# keeps the logging adapter and sends nothing, which is the right default for a
# development machine.
#
# MAIL_USERNAME and MAIL_PASSWORD are BOTH the same value: the Server API Token,
# from Servers -> your server -> API Tokens. NOT the Account token, which lives
# under account settings, looks identical, and is rejected by SMTP.
MAIL_USERNAME=
MAIL_PASSWORD=

# The envelope sender. Must be a confirmed Sender Signature, or any address on a
# domain verified in Postmark. Defaults to no-reply@dooklytics.com when unset.
#
# It does double duty: the domain here is also where an order conversation's
# Message-IDs live. Point it at an address on a domain you do not control and
# every id in the thread is stamped with somebody else's name.
MAIL_FROM=
MAIL_FROM_NAME=

# NOTE ON PENDING APPROVAL
# A new Postmark account may only send to addresses on domains verified in that
# account, until a human approves it. An order mail is ONE message to every
# recipient, so a single outside address — a personal Gmail on a test mailing
# list, say — fails the whole send for everybody.
